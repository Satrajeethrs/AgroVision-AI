# LLM provider configuration
# Fill only the provider you want to use. Keep this file private (don't commit to git).

# -----------------------
# Gemini (Google Gemini) - example
# Set either GEMINI_API_KEY or GEMINI_KEY
GEMINI_API_KEY=
# GEMINI_KEY=
# Optional: if you use a non-default Gemini endpoint
# GEMINI_BASE_URL=

# -----------------------
# LM Studio - example
# Set either LMSTUDIO_API_KEY or LM_STUDIO_KEY
LMSTUDIO_API_KEY=
# LM_STUDIO_KEY=
# Default LM Studio base (change if different)
LMSTUDIO_BASE_URL=http://127.0.0.1:1234
# -----------------------
# Other options
# DEBUG=true

# -----------------------
# AI4Bharat IndicTrans2 Translation
# For multilingual support in 12 Indian languages
# Uses open-source IndicTrans2 models - NO API KEY REQUIRED!
# Models are downloaded automatically on first use
# Requires: pip install IndicTransToolkit transformers sentencepiece sacremoses torch
ENABLE_TRANSLATION=True
DEFAULT_LANGUAGE=en
TRANSLATION_CACHE_SIZE=1000

# Hugging Face Hub authentication (needed for gated models)
# Generate a Read token at https://huggingface.co/settings/tokens
# and paste it below. Either variable name works.
HF_TOKEN=
HUGGINGFACE_HUB_TOKEN=REDACTED

# Optional: pin a specific IndicTrans2 revision (commit SHA or tag)
# Leave empty to use latest main branch
INDICTRANS2_REVISION=

# macOS stability: reduce native tokenizer/multiprocessing issues
TOKENIZERS_PARALLELISM=false
RAYON_NUM_THREADS=1
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1

# Emergency: Skip IndicTrans2 model loading (set to 1 to disable dynamic translation)
# UI will remain fully translated via static keys; only dynamic narrative stays English
# Currently REQUIRED on macOS due to native mutex crashes
SKIP_INDICTRANS2_MODELS=1

# Supported languages:
# en (English), hi (Hindi), ta (Tamil), te (Telugu), bn (Bengali), 
# mr (Marathi), kn (Kannada), ml (Malayalam), gu (Gujarati),
# pa (Punjabi), or (Odia), as (Assamese)

# Optional: Custom model cache directory (defaults to HuggingFace cache)
# INDICTRANS2_MODEL_DIR=/path/to/model/cache

# Optional: Override model repo names (advanced)
# INDICTRANS2_EN_INDIC=ai4bharat/indictrans2-en-indic-1B
# INDICTRANS2_INDIC_EN=ai4bharat/indictrans2-indic-en-1B

# Flask debug mode (set to 1 to enable, 0 to disable)
FLASK_DEBUG=0
