# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# Application Settings
APP_NAME=AgroVision-AI
APP_VERSION=1.0.0
PORT=5001

# LLM Provider Configuration (optional)
# Options: openai, anthropic, none
LLM_PROVIDER=none

# OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# Anthropic Configuration (if using Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Model Paths
MODEL_PATH=models/model.pkl
SCALER_PATH=models/scaler.pkl
DISEASE_MODEL_PATH=models/plant_disease_model_final.h5
CLASS_INDICES_PATH=models/plant_disease_class_indices.npy

# Data Paths
CROP_DATA_PATH=data/raw/crop_data.csv
FERTILIZER_DATA_PATH=data/raw/fertilizer.csv

# Upload Configuration
MAX_UPLOAD_SIZE=5242880  # 5MB in bytes
ALLOWED_EXTENSIONS=jpg,jpeg,png

# Database Configuration (for future use)
# DATABASE_URL=sqlite:///agrovision.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
